<h1>Sign up</h1>

<% @user.errors.full_messages.each do |message| %>
  <div style="color:red"><%= message %></div>
<% end %>

<%= form_with model: @user, url: registrations_path do |form| %>
  <%= form.label :email_address %><br>
  <%= form.email_field :email_address, required: true %><br><br>

  <%= form.label :password %><br>
  <%= form.password_field :password, required: true, maxlength: 72 %><br><br>

  <%= form.label :sex %><br>
  <%= form.select :sex, User.sexes.keys %><br><br>

  <%= form.label :weight_unit, "Preferred units" %><br>
  <%= form.select :weight_unit, User.weight_units.keys %><br><br>

  <%= form.submit "Sign up" %>
<% end %>
<br>

<%= link_to "Already have an account? Sign in", new_session_path %>
