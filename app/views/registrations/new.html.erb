<% content_for :title, "Sign up · Lifta" %>

<div class="box">
  <div class="box__header">Sign up</div>
  <div class="box__body">
    <%= form_with model: @user, url: registrations_path, class: "form" do |form| %>
      <% if @user.errors.any? %>
        <div class="errors">
          <% @user.errors.full_messages.each do |message| %>
            <div><%= message %></div>
          <% end %>
        </div>
      <% end %>

      <div class="field">
        <%= form.label :email_address %>
        <%= form.email_field :email_address, required: true, autocomplete: "email" %>
      </div>

      <div class="field">
        <%= form.label :username %>
        <%= form.text_field :username, required: true, maxlength: 20, autocomplete: "off", autocapitalize: "none" %>
        <p class="hint">3-20 letters, numbers or underscores. This is the name other lifters see.</p>
      </div>

      <div class="field">
        <%= form.label :password %>
        <%= form.password_field :password, required: true, maxlength: 72, autocomplete: "new-password" %>
      </div>

      <div class="field">
        <%= form.label :sex %>
        <%= form.select :sex, User.sexes.keys %>
        <p class="hint">The scoring formulas (DOTS, Sinclair) have separate male and female versions.</p>
      </div>

      <div class="field">
        <%= form.label :weight_unit, "Preferred units" %>
        <%= form.select :weight_unit, User.weight_units.keys %>
      </div>

      <div class="field field--checkbox">
        <%= form.check_box :public_profile %>
        <%= form.label :public_profile, "List me on the leaderboard, with a public profile page" %>
        <p class="hint">Shows your username, ranks and best lifts. Never your email or bodyweight. You can change this later.</p>
      </div>

      <%= form.hidden_field :time_zone, data: { controller: "timezone" } %>

      <%= form.submit "Sign up" %>
    <% end %>
    <br>

    <%= link_to "Already have an account? Sign in", new_session_path %>
  </div>
</div>
