<% page_title t(".title") %>

<div class="box">
  <div class="box__header"><%= t(".title") %></div>
  <div class="box__body">
    <% if @bodyweight_entries.any? %>
      <div class="table-scroll">
        <table>
          <thead>
            <tr><th scope="col"><%= t("columns.recorded") %></th><th scope="col"><%= t("columns.bodyweight") %></th><th scope="col"></th></tr>
          </thead>
          <tbody>
            <% @bodyweight_entries.each do |entry| %>
              <tr id="<%= dom_id(entry) %>">
                <td><%= format_time(entry.recorded_at) %></td>
                <td><%= format_weight(entry.kilograms) %></td>
                <td class="row-actions">
                  <%= link_to t("actions.edit"), edit_bodyweight_entry_path(entry) %>
                  <%= button_to t("actions.delete"), bodyweight_entry_path(entry), method: :delete, class: "link-button",
                        form: { data: { turbo_confirm: t(".confirm_delete") } } %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="muted"><%= t(".empty") %></p>
    <% end %>

    <p class="actions">
      <%= link_to t(".log"), new_bodyweight_entry_path, class: "btn-secondary" %>
      <%= link_to t(".back"), dashboard_path, class: "btn-secondary" %>
    </p>
  </div>
</div>
