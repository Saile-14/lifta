<% page_title t(".title") %>

<%= discipline_tabs(@discipline) { |discipline| leaderboard_path(discipline: discipline, sex: @sex) } %>

<div class="box">
  <div class="box__header"><%= t(".heading", discipline: @discipline.name) %></div>
  <div class="box__body">
    <div class="filters">
      <nav class="tabs tabs--small" aria-label="<%= t(".boards") %>">
        <%= link_to t(".overall"), leaderboard_path(discipline: @discipline, sex: @sex), aria: { current: ("page" unless @exercise) } %>
        <% @discipline.exercises.each do |exercise| %>
          <%= link_to exercise.name, leaderboard_path(discipline: @discipline, board: exercise.key, sex: @sex),
                aria: { current: ("page" if exercise == @exercise) } %>
        <% end %>
      </nav>

      <nav class="segmented" aria-label="<%= t(".sex_filter") %>">
        <% { nil => t(".everyone"), "male" => t(".men"), "female" => t(".women") }.each do |sex, label| %>
          <%= link_to label, leaderboard_path(discipline: @discipline, board: @exercise&.key, sex: sex),
                aria: { current: ("page" if sex == @sex) } %>
        <% end %>
      </nav>
    </div>

    <% if @leaderboard.entries.any? %>
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th>#</th><th><%= t("columns.lifter") %></th><th><%= t("columns.rank") %></th>
              <% if @discipline.weighted? || @exercise %><th><%= t("columns.score") %></th><% end %>
              <% if @exercise %><th><%= t("columns.best_lift") %></th><% end %>
            </tr>
          </thead>
          <tbody>
            <% @leaderboard.entries.each do |entry| %>
              <tr class="<%= "is-self" if entry.user == Current.user %>">
                <td><%= entry.position %></td>
                <td><%= link_to "@#{entry.user.username}", lifter_path(entry.user.username) %></td>
                <td><%= tier_badge(entry.tier) %></td>
                <% if @discipline.weighted? || @exercise %><td><%= format_score(entry.score, @discipline) %></td><% end %>
                <% if @exercise %><td><%= lift_result(entry.lift) if entry.lift %></td><% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="muted"><%= t(".empty") %></p>
    <% end %>

    <p class="muted">
      <%= t(".explanation") %>
      <%= t(".explanation_overall") unless @exercise %>
    </p>

    <% if Current.user %>
      <p>
        <% if (position = @leaderboard.position_of(Current.user)) %>
          <%= t(".position", position: position, total: @leaderboard.size) %>
        <% elsif !Current.user.public_profile? %>
          <%= t(".not_listed_html", link: link_to(t(".not_listed_link"), settings_path)) %>
        <% end %>
      </p>
    <% end %>
  </div>
</div>
