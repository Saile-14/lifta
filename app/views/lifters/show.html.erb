<% page_title "@#{@lifter.username}" %>
<% summary = ranks_summary(@rank_cards) %>
<%# Shared links open in the sharer's language, link previews included %>
<% share_url = lifter_url(@lifter.username, locale: I18n.locale) %>
<% content_for :head do %>
  <meta name="description" content="<%= summary %>">
  <meta property="og:type" content="profile">
  <meta property="og:site_name" content="Lifta">
  <meta property="og:locale" content="<%= I18n.locale == :ja ? "ja_JP" : "en_US" %>">
  <meta property="og:title" content="<%= t(".og_title", username: @lifter.username) %>">
  <meta property="og:description" content="<%= summary %>">
  <meta property="og:url" content="<%= share_url %>">
  <meta name="twitter:card" content="summary">
<% end %>

<% unless @lifter.public_profile? %>
  <p class="note">
    <% if @lifter == Current.user %>
      <%= t(".private_self") %> <%= link_to t(".make_public"), settings_path %>
    <% else %>
      <%= t(".private_admin") %>
    <% end %>
  </p>
<% end %>

<section class="profile-card">
  <div class="profile-card__head">
    <div>
      <h1 class="profile-card__name">@<%= @lifter.username %></h1>
      <p class="muted"><%= t(".since", date: l(@lifter.created_at.to_date, format: :month_year)) %></p>
    </div>
    <% if @lifter.public_profile? %>
      <button type="button" class="btn-small" data-controller="share" data-action="share#share"
              data-share-url-value="<%= share_url %>"
              data-share-title-value="<%= t(".og_title", username: @lifter.username) %>"
              data-share-text-value="<%= summary %>"
              data-share-copied-value="<%= t(".link_copied") %>">
        <span data-share-target="label"><%= t(".share") %></span>
      </button>
    <% end %>
  </div>

  <% @rank_cards.each do |card| %>
    <%= render "shared/rank_row", label: card.discipline.name, tier: card.overall,
          detail: (t(".overall_pending") if card.ranked? && !card.complete?) %>
  <% end %>
</section>

<% @rank_cards.select(&:ranked?).each do |card| %>
  <div class="box">
    <div class="box__header"><%= card.discipline.name %></div>
    <div class="box__body">
      <% card.rows.each do |row| %>
        <%= render "shared/rank_row", label: row.exercise.name, tier: row.tier,
              detail: (t(".best", result: lift_result(row.lift), date: format_date(row.lift.lifted_at)) if row.lift) %>
      <% end %>
    </div>
  </div>
<% end %>

<% if @rank_cards.none?(&:ranked?) %>
  <p class="muted"><%= t(".no_ranks") %></p>
<% end %>

<p><%= link_to t(".see_leaderboard"), leaderboard_path, class: "btn-secondary" %></p>
