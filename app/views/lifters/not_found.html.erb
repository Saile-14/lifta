<% page_title t(".title") %>
<% content_for :head do %>
  <meta name="robots" content="noindex">
<% end %>

<div class="hero">
  <h1><%= t(".heading") %></h1>
  <p><%= t(".explanation", username: @username) %></p>
  <div class="hero__actions">
    <%= link_to t(".see_leaderboard"), leaderboard_path, class: "btn-primary" %>
    <%= link_to t(".home"), root_path, class: "btn-secondary" %>
  </div>
</div>
