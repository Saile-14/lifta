<% page_title "@#{@user.username}" %>
<% content_for :page_class, "page--wide" %>

<%= render "admin/tabs" %>

<div class="box">
  <div class="box__header">
    @<%= @user.username %>
    <% if @user.admin? %><span class="badge badge--admin"><%= t("admin.badge") %></span><% end %>
  </div>
  <div class="box__body">
    <table class="details">
      <tr><th scope="row"><%= t(".email") %></th><td><%= @user.email_address %></td></tr>
      <tr><th scope="row"><%= t(".sex") %></th><td><%= t("sexes.#{@user.sex}") %></td></tr>
      <tr><th scope="row"><%= t(".joined") %></th><td><%= format_date(@user.created_at) %></td></tr>
      <tr><th scope="row"><%= t(".current_bodyweight") %></th><td><%= format_weight(@user.current_bodyweight_kg) %></td></tr>
      <tr>
        <th><%= t(".leaderboard") %></th>
        <td><%= @user.public_profile? ? t(".listed") : t(".not_listed") %> · <%= link_to t(".profile"), lifter_path(@user.username) %></td>
      </tr>
    </table>

    <% unless @user == Current.user %>
      <p class="actions">
        <%= button_to t(".delete_user"), admin_user_path(@user), method: :delete, class: "btn-small",
              form: { data: { turbo_confirm: t(".confirm_delete_user", username: @user.username, count: @lifts.size) } } %>
      </p>
    <% end %>
  </div>
</div>

<div class="box">
  <div class="box__header"><%= t(".lifts") %></div>
  <div class="box__body">
    <% if @lifts.any? %>
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th scope="col"><%= t("columns.date") %></th><th scope="col"><%= t("columns.lift") %></th><th scope="col"><%= t("columns.result") %></th>
              <th scope="col"><%= t("columns.bodyweight") %></th><th scope="col"><%= t("columns.rank") %></th><th scope="col"></th>
            </tr>
          </thead>
          <tbody>
            <% @lifts.each do |lift| %>
              <tr id="<%= dom_id(lift) %>">
                <td><%= format_date(lift.lifted_at) %></td>
                <td><%= lift.exercise_name %></td>
                <td><%= lift_result(lift) %></td>
                <td><%= format_weight(lift.bodyweight_kg) %></td>
                <td><%= tier_badge(lift.tier) %> <%= status_badge(lift) %></td>
                <td class="row-actions"><%= render "admin/lifts/actions", lift: lift %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="muted"><%= t(".no_lifts") %></p>
    <% end %>
  </div>
</div>
