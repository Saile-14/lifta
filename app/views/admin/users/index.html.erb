<% page_title t(".title") %>
<% content_for :page_class, "page--wide" %>

<%= render "admin/tabs" %>

<div class="box">
  <div class="box__header"><%= t(".title") %></div>
  <div class="box__body">
    <%= form_with url: admin_users_path, method: :get, class: "field field__inline" do |form| %>
      <%= form.search_field :q, value: @query, placeholder: t(".search_placeholder"), aria: { label: t(".search_label") } %>
      <%= form.submit t(".search"), name: nil, class: "btn-small" %>
      <% if @query.present? %><%= link_to t(".clear"), admin_users_path, class: "btn-secondary" %><% end %>
    <% end %>

    <% if @users.any? %>
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th scope="col"><%= t("columns.user") %></th><th scope="col"><%= t("columns.email") %></th><th scope="col"><%= t("columns.joined") %></th>
              <th scope="col"><%= t("columns.lifts") %></th><th scope="col"><%= t("columns.pending") %></th><th scope="col"></th>
            </tr>
          </thead>
          <tbody>
            <% @users.each do |user| %>
              <tr id="<%= dom_id(user) %>">
                <td>
                  <%= link_to "@#{user.username}", admin_user_path(user) %>
                  <% if user.admin? %><span class="badge badge--admin"><%= t("admin.badge") %></span><% end %>
                </td>
                <td><%= user.email_address %></td>
                <td><%= format_date(user.created_at) %></td>
                <td><%= @lift_counts.fetch(user.id, 0) %></td>
                <td><%= @pending_counts.fetch(user.id, 0).nonzero? %></td>
                <td class="row-actions"><%= link_to t("actions.manage"), admin_user_path(user) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="muted"><%= t(".empty") %></p>
    <% end %>
  </div>
</div>
