<% page_title t(".title") %>
<% content_for :page_class, "page--wide" %>

<%= render "admin/tabs" %>

<div class="box">
  <div class="box__header"><%= t(".heading") %></div>
  <div class="box__body">
    <p class="muted"><%= t(".intro") %></p>

    <nav class="tabs tabs--small" aria-label="<%= t(".status") %>">
      <% %w[ pending rejected ].each do |status| %>
        <%= link_to t(".#{status}", count: @counts.fetch(status, 0)), admin_lifts_path(status: status),
              aria: { current: ("page" if status == @status) } %>
      <% end %>
    </nav>

    <% if @lifts.any? %>
      <div class="table-scroll">
        <table class="table--wide">
          <thead>
            <tr>
              <th scope="col"><%= t("columns.lifter") %></th><th scope="col"><%= t("columns.lift") %></th><th scope="col"><%= t("columns.result") %></th>
              <th scope="col"><%= t("columns.bodyweight") %></th><th scope="col"><%= t("columns.date") %></th><th scope="col"><%= t("columns.score") %></th>
              <th scope="col"><%= t("columns.rank") %></th><th scope="col"></th>
            </tr>
          </thead>
          <tbody>
            <% @lifts.each do |lift| %>
              <tr id="<%= dom_id(lift) %>">
                <td><%= link_to "@#{lift.user.username}", admin_user_path(lift.user) %></td>
                <td><%= lift.exercise_name %></td>
                <td><%= lift_result(lift) %></td>
                <td><%= format_weight(lift.bodyweight_kg) %></td>
                <td><%= format_date(lift.lifted_at) %></td>
                <td><%= format_score(lift.score, lift.discipline) %></td>
                <td><%= tier_badge(lift.tier) %></td>
                <td class="row-actions"><%= render "admin/lifts/actions", lift: lift %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="muted"><%= t(".empty_#{@status}") %></p>
    <% end %>
  </div>
</div>
