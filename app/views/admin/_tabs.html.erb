<% pending_count = Lift.pending.count %>
<nav class="tabs" aria-label="<%= t(".label") %>">
  <%= link_to admin_lifts_path, aria: { current: ("page" if controller_name == "lifts") } do %>
    <%= t(".review_queue") %><% if pending_count.positive? %><span class="site-nav__count"><%= pending_count %></span><% end %>
  <% end %>
  <%= link_to t(".users"), admin_users_path, aria: { current: ("page" if controller_name == "users") } %>
</nav>
