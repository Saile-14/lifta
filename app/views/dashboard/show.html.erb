<div class="grid">
  <div class="box">
    <div class="box__header">Your ranks</div>
    <div class="box__body">
      <% @rank_card.rows.each do |row| %>
        <%= render "shared/rank_row", label: row.exercise.name, tier: row.tier %>
      <% end %>
      <%= render "shared/rank_row", label: "Overall", tier: @rank_card.overall %>
      <p><%= link_to "Log a lift", new_lift_path, class: "btn-secondary" %> <%= link_to "Lift history", lifts_path, class: "btn-secondary" %></p>
    </div>
  </div>

  <div class="box">
    <div class="box__header">Bodyweight</div>
    <div class="box__body">
      <% if @current_bodyweight_kg %>
        <p>
          Current: <%= number_with_precision(@current_bodyweight_kg, precision: 1) %> kg
          (<%= number_with_precision(WeightConversion.from_kg(@current_bodyweight_kg, "lb"), precision: 1) %> lb)
        </p>
      <% else %>
        <p>No bodyweight logged yet.</p>
      <% end %>
      <p><%= link_to "Log bodyweight", new_bodyweight_entry_path, class: "btn-secondary" %> <%= link_to "Bodyweight history", bodyweight_entries_path, class: "btn-secondary" %></p>
    </div>
  </div>
</div>

<div class="box">
  <div class="box__header">Recent lifts</div>
  <div class="box__body">
    <table>
      <tr><th>Date</th><th>Exercise</th><th>Weight (kg)</th><th>Reps</th><th>Rank</th></tr>
      <% @recent_lifts.each do |lift| %>
        <tr>
          <td><%= lift.lifted_at %></td>
          <td><%= lift.exercise_name %></td>
          <td><%= lift.weight_lifted %></td>
          <td><%= lift.reps %></td>
          <td><%= lift.tier&.label %></td>
        </tr>
      <% end %>
    </table>
  </div>
</div>
