<% content_for :title, "Dashboard · Lifta" %>

<%= discipline_tabs(@discipline) { |discipline| dashboard_path(discipline: discipline) } %>

<div class="box">
  <div class="box__header">Your <%= @discipline.name.downcase %> ranks</div>
  <div class="box__body">
    <%= render "shared/rank_row", label: "Overall", tier: @rank_card.overall, detail: overall_detail(@rank_card), overall: true %>
    <% @rank_card.rows.each do |row| %>
      <%= render "shared/rank_row", label: row.exercise.name, tier: row.tier, detail: rank_row_detail(row) %>
    <% end %>

    <% if @pending_count.positive? %>
      <p class="note">
        <%= pluralize(@pending_count, "lift") %> waiting for review. Diamond-level lifts count once an admin approves them.
      </p>
    <% end %>

    <p class="actions">
      <%= link_to "Log a lift", new_lift_path(discipline: @discipline), class: "btn-primary" %>
      <%= link_to "Lift history", lifts_path(discipline: @discipline), class: "btn-secondary" %>
    </p>
  </div>
</div>

<div class="grid">
  <div class="box">
    <div class="box__header">Bodyweight</div>
    <div class="box__body">
      <% if @current_bodyweight_kg %>
        <p class="stat"><%= format_weight(@current_bodyweight_kg) %></p>
      <% else %>
        <p>No bodyweight logged yet. It's needed to score barbell lifts.</p>
      <% end %>
      <p class="actions">
        <%= link_to "Log bodyweight", new_bodyweight_entry_path, class: "btn-secondary" %>
        <%= link_to "History", bodyweight_entries_path, class: "btn-secondary" %>
      </p>
    </div>
  </div>

  <div class="box">
    <div class="box__header">How ranks work</div>
    <div class="box__body">
      <p class="muted">
        Each lift is scored with <%= @discipline.score_label == "reps" ? "bodyweight-equivalent reps" : @discipline.score_label %>
        and ranked against a world-class standard for your sex: bronze, silver, gold, platinum, diamond, grandmaster.
      </p>
    </div>
  </div>
</div>

<div class="box">
  <div class="box__header">Recent lifts</div>
  <div class="box__body">
    <% if @recent_lifts.any? %>
      <div class="table-scroll">
        <table>
          <thead>
            <tr><th>Date</th><th>Lift</th><th>Result</th><th>Rank</th></tr>
          </thead>
          <tbody>
            <% @recent_lifts.each do |lift| %>
              <tr>
                <td><%= format_date(lift.lifted_at) %></td>
                <td><%= lift.exercise_name %></td>
                <td><%= lift_result(lift) %></td>
                <td><%= tier_badge(lift.tier) %> <%= status_badge(lift) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="muted">Nothing logged yet.</p>
    <% end %>
  </div>
</div>
