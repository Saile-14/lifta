<% page_title t(".title") %>

<%= discipline_tabs(@discipline) { |discipline| dashboard_path(discipline: discipline) } %>

<div class="box">
  <div class="box__header"><%= t(".heading", discipline: @discipline.name.downcase) %></div>
  <div class="box__body">
    <%= render "shared/rank_row", label: t("ranks.overall"), tier: @rank_card.overall, detail: overall_detail(@rank_card), overall: true %>
    <% @rank_card.rows.each do |row| %>
      <%= render "shared/rank_row", label: row.exercise.name, tier: row.tier, detail: rank_row_detail(row) %>
    <% end %>

    <% if @pending_count.positive? %>
      <p class="note"><%= t(".pending", count: @pending_count) %></p>
    <% end %>

    <p class="actions">
      <%= link_to t(".log_lift"), new_lift_path(discipline: @discipline), class: "btn-primary" %>
      <%= link_to t(".history"), lifts_path(discipline: @discipline), class: "btn-secondary" %>
    </p>
  </div>
</div>

<div class="grid">
  <div class="box">
    <div class="box__header"><%= t(".bodyweight") %></div>
    <div class="box__body">
      <% if @current_bodyweight_kg %>
        <p class="stat"><%= format_weight(@current_bodyweight_kg) %></p>
      <% else %>
        <p><%= t(".no_bodyweight") %></p>
      <% end %>
      <p class="actions">
        <%= link_to t(".log_bodyweight"), new_bodyweight_entry_path, class: "btn-secondary" %>
        <%= link_to t(".bodyweight_history"), bodyweight_entries_path, class: "btn-secondary" %>
      </p>
    </div>
  </div>

  <div class="box">
    <div class="box__header"><%= t(".how_ranks_work") %></div>
    <div class="box__body">
      <p class="muted"><%= t("explanations.#{@discipline.key}") %></p>
    </div>
  </div>
</div>

<div class="box">
  <div class="box__header"><%= t(".recent_lifts") %></div>
  <div class="box__body">
    <% if @recent_lifts.any? %>
      <div class="table-scroll">
        <table>
          <thead>
            <tr><th><%= t("columns.date") %></th><th><%= t("columns.lift") %></th><th><%= t("columns.result") %></th><th><%= t("columns.rank") %></th></tr>
          </thead>
          <tbody>
            <% @recent_lifts.each do |lift| %>
              <tr>
                <td><%= format_date(lift.lifted_at) %></td>
                <td><%= lift.exercise_name %></td>
                <td><%= lift_result(lift) %></td>
                <td><%= tier_badge(lift.tier) %> <%= status_badge(lift) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="muted"><%= t(".nothing_logged") %></p>
    <% end %>
  </div>
</div>
