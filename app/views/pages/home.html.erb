<% page_title t(".title") %>

<div class="hero">
  <h1><%= t(".heading") %></h1>
  <p><%= t(".intro_html",
           dots: link_to(t(".dots"), "https://en.wikipedia.org/wiki/DOTS_(formula)"),
           sinclair: link_to(t(".sinclair"), "https://en.wikipedia.org/wiki/Sinclair_coefficient")) %></p>
  <div class="hero__actions">
    <%= link_to t(".sign_up"), new_registration_path, class: "btn-primary" %>
    <%= link_to t(".sign_in"), new_session_path, class: "btn-secondary" %>
    <%= link_to t(".see_leaderboard"), leaderboard_path, class: "btn-secondary" %>
  </div>
</div>

<div class="grid">
  <div class="box">
    <div class="box__header"><%= t(".example_heading") %></div>
    <div class="box__body">
      <%= render "shared/rank_row", label: t("ranks.overall"), tier: Tier.new(63.5), detail: t(".example_total"), overall: true %>
      <%= render "shared/rank_row", label: t("exercises.squat"), tier: Tier.new(64.1) %>
      <%= render "shared/rank_row", label: t("exercises.bench"), tier: Tier.new(57.9), detail: t(".example_next") %>
      <%= render "shared/rank_row", label: t("exercises.deadlift"), tier: Tier.new(66.8) %>
    </div>
  </div>

  <div class="box">
    <div class="box__header"><%= t(".how_heading") %></div>
    <div class="box__body">
      <ol>
        <li><%= t(".step_1") %></li>
        <li><%= t(".step_2") %></li>
        <li><%= t(".step_3") %></li>
        <li><%= t(".step_4") %></li>
      </ol>
    </div>
  </div>
</div>
