<% page_title t(".title") %>

<div class="box">
  <div class="box__header"><%= t(".title") %></div>
  <div class="box__body">
    <%= form_with model: @user, url: settings_path, method: :patch, class: "form" do |form| %>
      <% if @user.errors.any? %>
        <div class="errors">
          <% @user.errors.full_messages.each do |message| %>
            <div><%= message %></div>
          <% end %>
        </div>
      <% end %>

      <div class="field">
        <%= form.label :username, t(".username") %>
        <%= form.text_field :username, required: true, maxlength: 20, autocomplete: "off", autocapitalize: "none" %>
        <p class="hint"><%= t(".username_hint", url: lifter_url(@user.username_was || @user.username)) %></p>
      </div>

      <div class="field field--checkbox">
        <%= form.check_box :public_profile %>
        <%= form.label :public_profile, t(".public_profile") %>
        <p class="hint"><%= t(".public_profile_hint") %></p>
      </div>

      <fieldset class="field field--group">
        <legend><%= t(".badges") %></legend>
        <p class="hint"><%= t(".badges_hint") %></p>
        <%# A blank entry so unticking every box submits an empty list %>
        <%= hidden_field_tag "user[featured_badges][]", "" %>
        <% User::BADGES.each do |badge| %>
          <div class="field--checkbox">
            <%= check_box_tag "user[featured_badges][]", badge, @user.features_badge?(badge), id: "user_badge_#{badge}" %>
            <%= label_tag "user_badge_#{badge}", badge == ComboCard::KEY ? t("ranks.combo") : Discipline.find(badge).name %>
          </div>
        <% end %>
      </fieldset>

      <div class="field">
        <%= form.label :weight_unit, t(".units") %>
        <%= form.select :weight_unit, User.weight_units.keys %>
      </div>

      <div class="field">
        <%= form.label :time_zone, t(".time_zone") %>
        <%= form.select :time_zone, time_zone_options(@user.time_zone) %>
        <p class="hint"><%= t(".time_zone_hint") %></p>
      </div>

      <%= form.submit t(".submit") %>
    <% end %>
  </div>
</div>

<div class="box">
  <div class="box__header"><%= t(".account") %></div>
  <div class="box__body">
    <p class="muted"><%= t(".signed_in_as", email: @user.email_address, sex: t("sexes.#{@user.sex}").downcase) %></p>
  </div>
</div>
