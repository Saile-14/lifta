<% page_title t(".title") %>

<div class="box">
  <div class="box__header"><%= t(".title") %></div>
  <div class="box__body">
    <%= form_with url: session_path, class: "form" do |form| %>
      <div class="field">
        <%= form.label :email_address, t(".email_address") %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
              placeholder: t(".email_placeholder"), value: params[:email_address] %>
      </div>

      <div class="field">
        <%= form.label :password, t(".password") %>
        <%= form.password_field :password, required: true, autocomplete: "current-password",
              placeholder: t(".password_placeholder"), maxlength: 72 %>
      </div>

      <%= form.submit t(".submit") %>
    <% end %>

    <p class="actions">
      <% if Rails.configuration.x.password_resets_enabled %>
        <%= link_to t(".forgot_password"), new_password_path, class: "btn-secondary" %>
      <% end %>
      <%= link_to t(".sign_up"), new_registration_path, class: "btn-secondary" %>
    </p>
  </div>
</div>
