<% page_title t(".title") %>

<div class="box">
  <div class="box__header"><%= t(".heading", exercise: @lift.exercise_name.downcase) %></div>
  <div class="box__body">
    <%= render "form", lift: @lift, discipline: @discipline, values: @values %>
    <p class="muted"><%= t(".review_note") %></p>
    <p><%= link_to t(".back"), lifts_path(discipline: @discipline), class: "btn-secondary" %></p>
  </div>
</div>
