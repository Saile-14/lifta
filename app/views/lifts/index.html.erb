<% content_for :title, "Lift history · Lifta" %>
<% content_for :page_class, "page--wide" %>

<div class="box">
  <div class="box__header">Lift history</div>
  <div class="box__body">
    <nav class="tabs tabs--small" aria-label="Filter by discipline">
      <%= link_to "All", lifts_path, aria: { current: ("page" unless @discipline) } %>
      <% Discipline.all.each do |discipline| %>
        <%= link_to discipline.name, lifts_path(discipline: discipline), aria: { current: ("page" if discipline == @discipline) } %>
      <% end %>
    </nav>

    <% if @lifts.any? %>
      <div class="table-scroll">
        <table>
          <thead>
            <tr><th>Date</th><th>Lift</th><th>Result</th><th>Bodyweight</th><th>Score</th><th>Rank</th><th></th></tr>
          </thead>
          <tbody>
            <% @lifts.each do |lift| %>
              <tr id="<%= dom_id(lift) %>">
                <td><%= format_date(lift.lifted_at) %></td>
                <td><%= lift.exercise_name %></td>
                <td><%= lift_result(lift) %></td>
                <td><%= format_weight(lift.bodyweight_kg) %></td>
                <td><%= format_score(lift.score, lift.discipline) %></td>
                <td><%= tier_badge(lift.tier) %> <%= status_badge(lift) %></td>
                <td class="row-actions">
                  <%= link_to "Edit", edit_lift_path(lift) %>
                  <%= button_to "Delete", lift_path(lift), method: :delete, class: "link-button",
                        form: { data: { turbo_confirm: "Delete this #{lift.exercise_name.downcase}?" } } %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="muted">No lifts logged yet.</p>
    <% end %>

    <p class="actions">
      <%= link_to "Log a lift", new_lift_path(discipline: @discipline), class: "btn-secondary" %>
      <%= link_to "Back to dashboard", dashboard_path(discipline: @discipline), class: "btn-secondary" %>
    </p>
  </div>
</div>
