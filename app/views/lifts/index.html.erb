<div class="box">
  <div class="box__header">Lift history</div>
  <div class="box__body">
    <table>
      <tr><th>Date</th><th>Exercise</th><th>Weight (kg)</th><th>Reps</th><th>Bodyweight (kg)</th><th>Rank</th></tr>
      <% @lifts.each do |lift| %>
        <tr>
          <td><%= lift.lifted_at %></td>
          <td><%= lift.exercise_name %></td>
          <td><%= lift.weight_lifted %></td>
          <td><%= lift.reps %></td>
          <td><%= lift.bodyweight_kg %></td>
          <td><%= lift.tier&.label %></td>
        </tr>
      <% end %>
    </table>

    <p><%= link_to "Log another", new_lift_path, class: "btn-secondary" %> <%= link_to "Back", dashboard_path, class: "btn-secondary" %></p>
  </div>
</div>
