<% page_title t(".title") %>
<% content_for :page_class, "page--wide" %>

<div class="box">
  <div class="box__header"><%= t(".title") %></div>
  <div class="box__body">
    <nav class="tabs tabs--small" aria-label="<%= t(".filter") %>">
      <%= link_to t(".all"), lifts_path, aria: { current: ("page" unless @discipline) } %>
      <% Discipline.all.each do |discipline| %>
        <%= link_to discipline.name, lifts_path(discipline: discipline), aria: { current: ("page" if discipline == @discipline) } %>
      <% end %>
    </nav>

    <% if @lifts.any? %>
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th scope="col"><%= t("columns.date") %></th><th scope="col"><%= t("columns.lift") %></th><th scope="col"><%= t("columns.result") %></th>
              <th scope="col"><%= t("columns.bodyweight") %></th><th scope="col"><%= t("columns.score") %></th><th scope="col"><%= t("columns.rank") %></th><th scope="col"></th>
            </tr>
          </thead>
          <tbody>
            <% @lifts.each do |lift| %>
              <tr id="<%= dom_id(lift) %>">
                <td><%= format_date(lift.lifted_at) %></td>
                <td><%= lift.exercise_name %></td>
                <td><%= lift_result(lift) %></td>
                <td><%= format_weight(lift.bodyweight_kg) %></td>
                <td><%= format_score(lift.score, lift.discipline) %></td>
                <td><%= tier_badge(lift.tier) %> <%= status_badge(lift) %></td>
                <td class="row-actions">
                  <%= link_to t("actions.edit"), edit_lift_path(lift) %>
                  <%= button_to t("actions.delete"), lift_path(lift), method: :delete, class: "link-button",
                        form: { data: { turbo_confirm: t(".confirm_delete", exercise: lift.exercise_name.downcase) } } %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="muted"><%= t(".empty") %></p>
    <% end %>

    <p class="actions">
      <%= link_to t(".log_lift"), new_lift_path(discipline: @discipline), class: "btn-secondary" %>
      <%= link_to t(".back"), dashboard_path(discipline: @discipline), class: "btn-secondary" %>
    </p>
  </div>
</div>
