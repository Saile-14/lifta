<%# locals: (lift:, discipline:, values: nil) -%>
<% values ||= {
     "unit" => weight_unit,
     "weight" => (weight_value(lift.weight_lifted) if lift.weight_lifted.to_f.positive?),
     "reps" => lift.reps,
     "lifted_at" => lift.lifted_at,
     "bodyweight" => (weight_value(lift.bodyweight_kg) if lift.persisted?)
   } %>
<% latest_bodyweight = Current.user.current_bodyweight_kg %>

<%= form_with scope: :lift, url: lift.persisted? ? lift_path(lift) : lifts_path, method: lift.persisted? ? :patch : :post, class: "form" do |form| %>
  <% if lift.errors.any? %>
    <div class="errors">
      <% lift.errors.full_messages.each do |message| %>
        <div><%= message %></div>
      <% end %>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :exercise, t(".exercise") %>
    <%= form.select :exercise, discipline.exercises.map { |exercise| [ exercise.name, exercise.key ] }, selected: lift.exercise %>
  </div>

  <% if discipline.weighted? %>
    <div class="field">
      <%= form.label :weight, t(".weight") %>
      <div class="field__inline">
        <%= form.number_field :weight, value: values["weight"], step: "any", min: 0, inputmode: "decimal", required: true %>
        <%= form.select :unit, %w[ kg lb ], { selected: values["unit"] }, aria: { label: t(".units") } %>
      </div>
    </div>

    <div class="field">
      <%= form.label :reps, t(".reps") %>
      <%= form.number_field :reps, value: values["reps"] || 1, min: 1, max: discipline.max_reps, inputmode: "numeric" %>
      <p class="hint"><%= t(".reps_hint", count: discipline.max_reps) %></p>
    </div>
  <% else %>
    <div class="field">
      <%= form.label :reps, t(".reps") %>
      <%= form.number_field :reps, value: values["reps"], min: 1, max: discipline.max_reps, inputmode: "numeric", required: true %>
      <p class="hint"><%= t(".strict_reps_hint") %></p>
    </div>

    <div class="field">
      <%= form.label :weight, t(".added_weight") %>
      <div class="field__inline">
        <%= form.number_field :weight, value: values["weight"], step: "any", min: 0, inputmode: "decimal" %>
        <%= form.select :unit, %w[ kg lb ], { selected: values["unit"] }, aria: { label: t(".units") } %>
      </div>
      <p class="hint"><%= t(".added_weight_hint") %></p>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :lifted_at, t(".date") %>
    <%= form.date_field :lifted_at, value: values["lifted_at"] || Current.user.today, max: Current.user.today %>
  </div>

  <div class="field">
    <%= form.label :bodyweight, t(".bodyweight") %>
    <%= form.number_field :bodyweight, value: values["bodyweight"], step: "any", min: 0, inputmode: "decimal",
          placeholder: (weight_value(latest_bodyweight, unit: values["unit"]) if latest_bodyweight) %>
    <p class="hint">
      <% if lift.persisted? %>
        <%= t(".bodyweight_hint_saved") %>
      <% elsif latest_bodyweight %>
        <%= t(".bodyweight_hint_blank") %>
      <% elsif discipline.weighted? %>
        <%= t(".bodyweight_hint_needed") %>
      <% else %>
        <%= t(".bodyweight_hint_optional") %>
      <% end %>
    </p>
  </div>

  <%= form.submit lift.persisted? ? t(".submit_edit") : t(".submit_new") %>
<% end %>
