<%# locals: (label:, tier:, detail: nil, overall: false) -%>
<div class="rank-row<%= " rank-row--overall" if overall %>">
  <div class="rank-row__label"><%= label %></div>
  <div class="rank-row__track">
    <div class="rank-row__fill rank-fill--<%= tier&.name || "unranked" %>" style="width: <%= tier&.fill_percent || 0 %>%"></div>
  </div>
  <div class="rank-row__value">
    <%= tier ? t("tiers.badge", tier: tier.label, percent: tier.display_percent) : t("tiers.unranked") %>
  </div>
  <% if detail.present? %>
    <div class="rank-row__detail"><%= detail %></div>
  <% end %>
</div>
