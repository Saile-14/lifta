<nav class="site-nav">
  <%= link_to "Lifta", authenticated? ? dashboard_path : root_path, class: "site-nav__brand" %>
  <% if authenticated? %>
    <%= link_to t(".dashboard"), dashboard_path %>
    <%= link_to t(".log_lift"), new_lift_path %>
    <%= link_to t(".leaderboard"), leaderboard_path %>
    <% if Current.user.admin? %>
      <% pending_count = Lift.pending.count %>
      <%= link_to admin_root_path do %><%= t(".admin") %><% if pending_count.positive? %><span class="site-nav__count"><%= pending_count %></span><% end %><% end %>
    <% end %>
    <span class="site-nav__spacer"></span>
    <%= link_to "@#{Current.user.username}", lifter_path(Current.user.username) %>
    <%= link_to t(".settings"), settings_path %>
    <%= link_to t(".sign_out"), session_path, data: { turbo_method: :delete } %>
  <% else %>
    <%= link_to t(".leaderboard"), leaderboard_path %>
    <span class="site-nav__spacer"></span>
    <%= link_to t(".sign_in"), new_session_path %>
    <%= link_to t(".sign_up"), new_registration_path %>
  <% end %>
  <%= locale_switch_link %>
</nav>
