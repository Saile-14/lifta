<nav class="site-nav">
  <%= link_to "[Lifta]", authenticated? ? dashboard_path : root_path, class: "site-nav__brand" %>
  <% if authenticated? %>
    <%= link_to "[Dashboard]", dashboard_path %>
    <%= link_to "[Log lift]", new_lift_path %>
    <%= link_to "[Log weight]", new_bodyweight_entry_path %>
    <span class="site-nav__spacer"></span>
    <span><%= Current.user.email_address %></span>
    <%= link_to "[Sign out]", session_path, data: { turbo_method: :delete } %>
  <% else %>
    <span class="site-nav__spacer"></span>
    <%= link_to "[Sign in]", new_session_path %>
    <%= link_to "[Sign up]", new_registration_path %>
  <% end %>
</nav>
